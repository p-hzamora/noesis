# noesis configuration. `noesis config init` writes a copy to ~/.config/noesis/.env;
# for development you can also copy it by hand. Never commit a real .env.
# Environment variables with the same names override values in that file.

# Folder that stores notes (an Obsidian vault, a plain folder, or an NFS mount).
# Not required when NOESIS_WRITER_BACKEND=mcp and NOESIS_SEARCH_BACKEND=obsidian-mcp
# (`notes list` still needs it).
NOESIS_VAULT_DIR=~/brain

# Writer backend: where `notes curate` stores the notes (NOESIS_WRITER_BACKEND).
#   filesystem  write Markdown files under NOESIS_VAULT_DIR. Default; makes no network call.
#               For NFS, point NOESIS_VAULT_DIR at the mount.
#   mcp         store the notes through Obsidian's MCP server (`vault_write`), using the
#               NOESIS_OBSIDIAN_MCP_* settings below.
#   vectra      write Markdown files under NOESIS_VAULT_DIR, then `vectra sync` them into
#               NOESIS_VECTRA_COLLECTION. A failed sync keeps the files and prints a notice.
# A storage failure parks the brief; run `noesis notes retry <ticket>` once it is fixed.
NOESIS_WRITER_BACKEND=filesystem

# Where per-session capture state and logs live (default: $XDG_STATE_HOME/noesis).
# NOESIS_STATE_DIR=~/.local/state/noesis

# Log level for noesis itself: DEBUG, INFO, WARNING, ERROR.
# NOESIS_LOG_LEVEL=INFO

# Capture: a change counts when it reaches either threshold; writes are debounced.
# NOESIS_CAPTURE_MIN_FILES=2
# NOESIS_CAPTURE_MIN_LINES=20
# NOESIS_CAPTURE_DEBOUNCE_SECONDS=300
# Journal every hook call, even the silent ones (debugging):
# NOESIS_CAPTURE_TRACE=false

# Curator: the headless Claude Code run that judges what is worth keeping.
# NOESIS_CURATOR_CLAUDE_BIN=claude
# NOESIS_CURATOR_MODEL=
# NOESIS_CURATOR_MAX_BUDGET_USD=0.5
# NOESIS_CURATOR_TIMEOUT_SECONDS=300
# NOESIS_CURATOR_RETRY_SECONDS=30
# Your own curator system prompt (Markdown); unset uses the one shipped with noesis:
# NOESIS_CURATOR_SYSTEM_PROMPT_FILE=~/.config/noesis/curator_system.md

# Recall: the agent behind `noesis notes recall`. noesis finds and reads the notes, masks
# secrets, and sends their text to the agent, which writes the task briefing. The agent has no
# tools and no access to the vault. `notes recall --no-synthesis` skips it (no model is called).
# Runtime = the program that runs the agent. Model = what that program is asked to use.
# They are separate settings; noesis passes the model and effort through without checking them,
# so use any name your runtime accepts.
#   claude-cli  headless Claude Code (`claude -p`). The only runtime today. Default.
# NOESIS_RECALL_RUNTIME=claude-cli
# Model: empty uses the runtime's default. For claude-cli, an alias (haiku, sonnet, opus) or a
# full id. Example, Claude Haiku 5.5 (id verified against Claude Code 2.1):
# NOESIS_RECALL_MODEL=claude-haiku-5-5
# Effort: empty uses the runtime's default. For claude-cli: low, medium, high, xhigh or max.
# NOESIS_RECALL_EFFORT=low
# NOESIS_RECALL_CLAUDE_BIN=claude
# NOESIS_RECALL_MAX_BUDGET_USD=0.25
# NOESIS_RECALL_TIMEOUT_SECONDS=120
# Most note text (characters) sent to the agent per recall, shared among the notes read:
# NOESIS_RECALL_MAX_INPUT_CHARS=60000

# Search backend: who answers `notes search` and the curator's related-notes lookup.
# Accepted values (NOESIS_SEARCH_BACKEND):
#   filesystem    scan the Markdown files of the vault. Default; works with any folder
#                 (plain, NFS, Obsidian vault) and makes no network call.
#   obsidian-mcp  ask Obsidian's MCP server: better ranking, the whole vault, always indexed.
#                 Falls back to files, with a notice, when Obsidian is closed.
#   vectra        semantic search in the vectra collection NOESIS_VECTRA_COLLECTION, which
#                 indexes NOESIS_VAULT_DIR. Falls back to files, with a notice, when vectra fails.
# `notes list` always uses the files; writes follow NOESIS_WRITER_BACKEND, not this setting.
# Check the setup with `noesis doctor`.
NOESIS_SEARCH_BACKEND=filesystem
# Obsidian's MCP server, for search and for the `mcp` writer.
NOESIS_OBSIDIAN_MCP_URL=http://127.0.0.1:27123/mcp/
# Only when the MCP server requires a token (kept out of logs and `config show`):
# NOESIS_OBSIDIAN_MCP_TOKEN=
NOESIS_OBSIDIAN_MCP_TIMEOUT_SECONDS=5

# vectra (the `vectra` search and writer backends, and manifest `vector` sources).
# The backends use NOESIS_VECTRA_COLLECTION over the whole vault; a manifest `vector` source
# is the collection named after the source, over its `path` (sync it with
# `vectra sync <name> <vault>/<path>`).
# NOESIS_VECTRA_BIN=vectra
# NOESIS_VECTRA_COLLECTION=noesis
# NOESIS_VECTRA_TIMEOUT_SECONDS=120
