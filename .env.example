# noesis configuration. `noesis config init` writes a copy to ~/.config/noesis/.env;
# for development you can also copy it by hand. Never commit a real .env.
# Environment variables with the same names override values in that file.

# Vault folder (an Obsidian vault or a plain folder), read only by `noesis import run`.
# Nothing is written to it.
NOESIS_VAULT_DIR=~/brain

# Where per-session capture state and logs live (default: $XDG_STATE_HOME/noesis).
# NOESIS_STATE_DIR=~/.local/state/noesis

# Log level for noesis itself: DEBUG, INFO, WARNING, ERROR.
# NOESIS_LOG_LEVEL=INFO

# Capture: a change counts when it reaches either threshold; writes are debounced.
# NOESIS_CAPTURE_MIN_FILES=2
# NOESIS_CAPTURE_MIN_LINES=20
# NOESIS_CAPTURE_DEBOUNCE_SECONDS=300
# Journal every hook call, even the silent ones (debugging):
# NOESIS_CAPTURE_TRACE=false

# Curator: the headless Claude Code run behind `noesis curate brief` that judges what is worth
# keeping. Its records are proposals; capture never accepts them.
# NOESIS_CURATOR_CLAUDE_BIN=claude
# NOESIS_CURATOR_MODEL=
# NOESIS_CURATOR_MAX_BUDGET_USD=0.5
# NOESIS_CURATOR_TIMEOUT_SECONDS=300
# NOESIS_CURATOR_RETRY_SECONDS=30
# Look up related records before judging: required (default; parks the brief if the lookup
# cannot answer) or off:
# NOESIS_CURATOR_RELATED_LOOKUP=required
# Your own curator system prompt (Markdown); unset uses the one shipped with noesis:
# NOESIS_CURATOR_SYSTEM_PROMPT_FILE=~/.config/noesis/curator_system.md

# Knowledge store (Neo4j): `noesis store init`, `noesis record ...`. Start it with
# `docker compose up -d` (compose.yaml, pinned neo4j:5.26.33-community); see docs/workflows/store.md.
# The password is a secret: set it only in your user-side profile (~/.config/noesis/.env or
# ~/.config/noesis/profiles/<repo>/<name>.env) or the environment, never in a file inside a
# repository. compose.yaml reads the same variable for the initial password.
# NOESIS_NEO4J_PASSWORD=
# NOESIS_NEO4J_URI=bolt://127.0.0.1:7687
# NOESIS_NEO4J_USER=neo4j
# NOESIS_NEO4J_DATABASE=neo4j
# An unreachable store fails closed (INTEGRATION_103) within this many seconds:
# NOESIS_NEO4J_CONNECT_TIMEOUT_SECONDS=5
# The knowledge space commands act in (letters, digits, `.`, `_`, `-`); `store init` creates it:
# NOESIS_KNOWLEDGE_SPACE=personal
# Seconds an index sync or rebuild may hold a projection's lock before another process may
# take it over (a crashed sync never releases it):
# NOESIS_INDEX_LOCK_TTL_SECONDS=300

# Recall: lexical + live graph evidence; --no-synthesis needs no model.
# NOESIS_RETRIEVAL_BRIEFING_CLAUDE_BIN=claude
# NOESIS_RETRIEVAL_BRIEFING_TIMEOUT_SECONDS=60
# NOESIS_RETRIEVAL_BRIEFING_MAX_BUDGET_USD=0.50
# NOESIS_RETRIEVAL_BRIEFING_MAX_EVIDENCE_CHARS=24000

# Semantic search (optional `noesis[semantic]` extra; English-only bge-small-en-v1.5).
# resident = use a running `noesis index embedder serve` (never auto-started);
# per-call = load the model only for `search --semantic` and index sync/rebuild; off = never.
# NOESIS_RETRIEVAL_SEMANTIC_MODE=resident
# Where `noesis index model prepare` stores the pinned model (default ~/.cache/noesis/models):
# NOESIS_RETRIEVAL_MODEL_CACHE_DIR=
# Root of the embedder's private socket directory (default $XDG_RUNTIME_DIR):
# NOESIS_RETRIEVAL_RUNTIME_DIR=
# ONNX inference threads (default: the runtime chooses):
# NOESIS_RETRIEVAL_EMBEDDER_THREADS=
